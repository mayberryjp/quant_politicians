# --- Infrastructure ---
DATABASE_URL=postgresql+psycopg://quant:quant_dev_password@localhost:5432/quant
QUANT_REDIS_URL=redis://localhost:6379/0
API_PORT=8017
POLL_INTERVAL=3600
LOCK_TTL=3600

# --- House data source ---
HOUSE_FD_BASE_URL=https://disclosures-clerk.house.gov
HOUSE_FD_YEARS=current
# BACKFILL_YEARS=2023,2024
TARGET_FILING_TYPES=P
PUBLISH_TRANSACTION_TYPES=purchase
# HISTORICAL_START_DATE=2026-01-01

# --- Ollama (vision-capable model REQUIRED, no default) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=180

# --- quant_signals producer ---
SIGNALS_API_URL=
SIGNALS_SOURCE_NAME=house-disclosures-v1
SIGNALS_TIMEOUT=30
SIGNAL_MARKET=stocks
SIGNAL_LOCALE=us
SIGNAL_TYPE=watchlist_candidate
PUBLISH_BATCH_SIZE=50

# --- HTTP / limits ---
HTTP_USER_AGENT=quant_politicians/0.1 (+https://github.com/mayberryjp/quant_politicians)
MAX_DOC_BYTES=52428800
MAX_DOC_PAGES=20

# --- Document retrieval ---
DOC_CACHE_DIR=/var/cache/quant_politicians
FETCH_BATCH_SIZE=50
FETCH_MAX_ATTEMPTS=3
FETCH_BACKOFF_SECONDS=2.0

# --- LLM extraction ---
EXTRACT_BATCH_SIZE=25
LLM_MAX_ATTEMPTS=3
RENDER_SCALE=2.0

# --- Senate data source (eFD) ---
SENATE_EFD_BASE_URL=https://efdsearch.senate.gov
# SENATE_REPORT_TYPES=   (PTR report-type code; verified in Senate Slice 2)
SENATE_FILER_TYPES=all
# SENATE_BACKFILL_START_DATE=01/01/2012
SENATE_SEARCH_PAGE_SIZE=100
SENATE_REQUEST_DELAY=2.0
SENATE_SIGNALS_SOURCE_NAME=senate-disclosures-v1
